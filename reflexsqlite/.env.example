# Copy to .env and adjust. All settings are validated at startup.
APP_NAME=DataForge
APP_ENV=development

# REQUIRED in production (>= 16 chars). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=replace-with-a-long-random-secret

# Paths default to <workspace>/data and <workspace>/uploads, i.e. one level
# ABOVE the app package. Do not move them inside reflexsqlite/: `reflex run`
# watches that tree, and the SQLite WAL files would trigger constant reloads.
# APP_DATA_DIR=D:/Python project/reflex/data
# APP_UPLOAD_DIR=D:/Python project/reflex/uploads
# APP_DATABASE_URL=sqlite:///D:/Python project/reflex/data/app.db

SESSION_TTL_HOURS=168
MAX_UPLOAD_MB=25
MAX_PREVIEW_ROWS=12
LIVE_REFRESH_MS=3000
MAX_TRAINING_ROWS=400
SEED_DEMO_DATA=true
